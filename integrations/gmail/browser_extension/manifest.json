{
    "manifest_version": 3,
    "name": "DLP Gmail Test",
    "version": "1.0.0",
    "description": "DLP test extension for Gmail attachments",

    "permissions": ["tabs"],

    "host_permissions": [
        "https://mail.google.com/*",
        "http://127.0.0.1:5000/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": ["https://mail.google.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
